# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRY=8h

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path is auto-managed; no config needed.
# To switch to PostgreSQL: replace better-sqlite3 with pg and update database.js

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=SOMAA Restobar <noreply@somaa.in>
ADMIN_EMAIL=manager@somaa.in

# ─── Capacity Settings ────────────────────────────────────────────────────────
MAX_CAPACITY=120
MAX_GUESTS_PER_SLOT=80

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC=10
RATE_LIMIT_ADMIN=120

# ─── SMS (optional) ───────────────────────────────────────────────────────────
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ─── WhatsApp (optional) ──────────────────────────────────────────────────────
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── Webhooks (optional) ──────────────────────────────────────────────────────
# WEBHOOK_URL=https://your-automation-tool.com/hook
# WEBHOOK_SECRET=your_webhook_secret

# ─── Admin Seed (only used by scripts/seed.js) ────────────────────────────────
SEED_ADMIN_NAME=SOMAA Admin
SEED_ADMIN_EMAIL=admin@somaa.in
SEED_ADMIN_PASS=Somaa@2026!
